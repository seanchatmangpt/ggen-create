{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.io/schemas/ggen-create/native-receipt.schema.json",
  "title": "ggen-create native receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "timestamp",
    "operation",
    "state",
    "subject_root",
    "inputs",
    "outputs",
    "parent",
    "algorithm",
    "receipt_digest"
  ],
  "properties": {
    "schema": {"const": "ggen-create-native-receipt/0.2"},
    "receipt_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {"type": "string", "minLength": 1},
    "state": {
      "enum": [
        "ALIVE",
        "PARTIAL_ALIVE",
        "UNKNOWN",
        "BLOCKED",
        "BUILD_BROKEN",
        "UNSUPPORTED",
        "REFUSED"
      ]
    },
    "subject_root": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "parent": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "algorithm": {"const": "sha256"},
    "receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
