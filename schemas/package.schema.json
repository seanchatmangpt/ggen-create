{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.io/schemas/ggen-create/package.schema.json",
  "title": "ggen-create package metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generator",
    "parameter",
    "gen_parent_dir",
    "files"
  ],
  "properties": {
    "schema": {"const": "ggen-create-package/0.2"},
    "generator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 _.-]{0,126}[A-Za-z0-9])?$"
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seed", "value"],
      "properties": {
        "id": {"const": "name"},
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 _.-]{0,126}[A-Za-z0-9])?$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 _.-]{0,126}[A-Za-z0-9])?$"
        }
      }
    },
    "gen_parent_dir": {"type": "boolean"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "template",
          "target",
          "path_replacements",
          "content_replacements"
        ],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "template": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "path_replacements": {"type": "integer", "minimum": 0},
          "content_replacements": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
