{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.io/schemas/ggen-create/capture.schema.json",
  "title": "ggen-create parity capture",
  "description": "Original hygen-create-compatible capture state. The session file location is the capture root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "about",
    "hygen_create_version",
    "name",
    "files_and_dirs",
    "templatize_using_name",
    "gen_parent_dir"
  ],
  "properties": {
    "about": {
      "type": "string",
      "const": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen."
    },
    "hygen_create_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "files_and_dirs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": {"pattern": "(^|/)\\.\\.(/|$)"}
      },
      "additionalProperties": {"type": "boolean"}
    },
    "templatize_using_name": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "gen_parent_dir": {
      "type": "boolean"
    }
  }
}
